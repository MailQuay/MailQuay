# Bootstrap environment. Runtime parameters are stored in PostgreSQL and
# edited at /settings/server; these values only seed the first startup.

# HTTP
MAILQUAY_LISTEN_ADDR=:8080
# Optional: public URL used to seed OAuth callbacks and cookie checks.
MAILQUAY_PUBLIC_URL=http://localhost:8080

# Database (required)
MAILQUAY_DATABASE_URL=postgres://mailquay:mailquay@127.0.0.1:5432/mailquay?sslmode=disable

# Storage (required)
MAILQUAY_DATA_DIR=./data
MAILQUAY_SEARCH_PATH=./data/search

# Required: base64 encoding of 32 random bytes, for example `openssl rand -base64 32`
MAILQUAY_SECRET_KEY=replace-with-base64-encoded-32-bytes

# Optional one-time setup token; generated and logged when empty
MAILQUAY_SETUP_TOKEN=

# Logging bootstrap values; the level can be changed later in the web UI
MAILQUAY_LOG_LEVEL=info
MAILQUAY_LOG_FORMAT=text

# Optional initial trusted proxy CIDRs (comma separated); editable in the UI
MAILQUAY_TRUSTED_PROXIES=
